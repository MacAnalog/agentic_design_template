{
  "permissions": {
    "ask": [
      "Read(//CMC/**)",
      "Edit(//CMC/**)",
      "Grep(//CMC/**)",
      "Glob(//CMC/**)"
    ],
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git submodule status:*)",
      "Bash(.sx/skills/bin/sx-link:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.sx/skills/hooks/cmc_ask_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.sx/skills/hooks/cmc_ask_hook.py\"; fi",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
